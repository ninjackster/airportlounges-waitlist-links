{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AirportLoungesList",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "airport_code",
      "airport_name",
      "city",
      "country",
      "terminal",
      "lounge_name",
      "network",
      "last_verified"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+-[a-z0-9]+-[a-z0-9-]+$",
        "description": "Standardized kebab-case identifier: <iata_code_lower>-<terminal_lower>-<lounge_slug>"
      },
      "airport_code": {
        "type": "string",
        "pattern": "^[A-Z]{3}$",
        "description": "3-letter uppercase IATA airport code"
      },
      "airport_name": {
        "type": "string",
        "minLength": 3
      },
      "city": {
        "type": "string",
        "minLength": 2
      },
      "country": {
        "type": "string",
        "pattern": "^[A-Z]{2}$",
        "description": "2-letter uppercase ISO country code"
      },
      "terminal": {
        "type": "string",
        "minLength": 1
      },
      "lounge_name": {
        "type": "string",
        "minLength": 2
      },
      "network": {
        "type": "string",
        "enum": [
          "American Express Centurion",
          "Chase Sapphire Lounge",
          "Capital One Lounge",
          "Delta Sky Club",
          "United Club",
          "American Airlines Admirals Club",
          "Priority Pass",
          "Plaza Premium",
          "Aspire",
          "Escape Lounges",
          "The Club",
          "Air France / KLM Lounge",
          "British Airways Galleries",
          "Independent"
        ]
      },
      "access_method": {
        "type": "string",
        "enum": [
          "web",
          "app"
        ],
        "default": "web",
        "description": "web = public web URL (waitlist or reservation link); app = native mobile app queue only (e.g. Amex app, Fly Delta app)"
      },
      "waitlist_url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://.*"
      },
      "booking_url": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://.*",
        "description": "Advance reservation for a chosen date and time, on the operator's own site. Distinct from waitlist_url, which is a free real-time queue. A lounge may have either, both, or neither."
      },
      "booking_cost": {
        "type": "string",
        "enum": [
          "cash",
          "credit",
          "free"
        ],
        "description": "What booking actually costs. cash = money to hold the slot. credit = settled against a Priority Pass / DragonPass / Dreamfolks credit, cash only if the member is short. free = costs nothing. Required whenever booking_url is present."
      },
      "notes": {
        "type": "string"
      },
      "last_verified": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      }
    },
    "additionalProperties": false
  }
}
